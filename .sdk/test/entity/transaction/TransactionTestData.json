    "GET /transactions": {
      "provenance": "operation-contract",
      "contract": {
        "operationId": "list-transactions",
        "parameters": [
          {
            "description": "Filter the list by Partner. The parameter value can be either a Partner ID or Name.",
            "in": "query",
            "name": "partner",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Filter the list by Client. The parameter value can be either a Client ID or Name.",
            "in": "query",
            "name": "client",
