# BasicAttestationFlow

main: kit: flow: BasicAttestationFlow:
{
  entity: "attestation",
  kind: "basic",
  name: "BasicAttestationFlow",
  step: [
    {
      input: {
        ref: "attestation_ref01"
      }

      op: "create"
    }

    {
      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "attestation_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "attestation_ref01",
        srcdatavar: "attestation_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "attestation01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-attestation_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicAttestationFlow"
}