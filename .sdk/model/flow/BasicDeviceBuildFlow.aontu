# BasicDeviceBuildFlow

main: kit: flow: BasicDeviceBuildFlow:
{
  entity: "device_build",
  kind: "basic",
  name: "BasicDeviceBuildFlow",
  step: [
    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "device_build_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "device_build_ref01",
        srcdatavar: "device_build_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "device_build01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-device_build_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicDeviceBuildFlow"
}