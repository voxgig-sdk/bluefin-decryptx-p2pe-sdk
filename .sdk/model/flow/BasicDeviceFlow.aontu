# BasicDeviceFlow

main: kit: flow: BasicDeviceFlow:
{
  entity: "device",
  kind: "basic",
  name: "BasicDeviceFlow",
  step: [
    {
      i: {
        ref: "device_ref01"
      }

      m: {
        serial_number: "serial_number01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "device_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "device_ref01",
        srcdatavar: "device_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "device01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-device_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicDeviceFlow"
}