# BasicDeviceFlow

main: kit: flow: BasicDeviceFlow:
{
  entity: "device",
  kind: "basic",
  name: "BasicDeviceFlow",
  step: [
    {
      input: {
        ref: "device_ref01"
      }

      match: {
        serial_number: "serial_number01"
      }

      op: "create"
    }

    {
      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "device_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "device_ref01",
        srcdatavar: "device_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "device01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-device_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicDeviceFlow"
}