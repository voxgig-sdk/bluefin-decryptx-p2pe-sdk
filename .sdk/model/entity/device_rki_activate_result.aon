            id: "POST /devices/rki/activate"
            json: "{\"operationId\":\"activate-rki-device\",\"parameters\":[],\"protocol\":\"http\",\"requestBody\":{\"content\":{\"*/*\":{\"schema\":{\"properties\":{\"appVersion\":{\"description\":\"If a Device Type has more than one Application Code version the supported version is specified here.\",\"example\":\"N/A\",\"type\":\"string\"},\"buildName\":{\"description\":\"The Device Builds's name.\",\"example\":\"SREDKey 2 - PTS 5.X\",\"type\":\"string\"},\"buildNumber\":{\"description\":\"The Build Number.\",\"example\":\"IDTECH-007\",\"type\":\"string\"},\"configFile\":{\"description\":\"\\\\?\",\"example\":\"\",\"type\":\"string\"},\"firmwareVersion\":{\"description\":\"A list of firmware versions that this Device Build covers.\",\"example\":\"SREDKEY2 FW v1.00.xxx.xxxx.S\",\"type\":\"string\"},\"hardwareVersion\":{\"description\":\"A list of hardware versions that this Device Build covers.\",\"example\":\"80172001(With MSR), 80172002(Without MSR)\",\"type\":\"string\"},\"serialNumber\":{\"description\":\"The referenced Device's serial number.\",\"example\":\"85000711\",\"type\":\"string\"},\"whiteListingBinRanges\":{\"description\":\"\\\\?\",\"example\":\"\",\"type\":\"string\"}},\"required\":[\"serialNumber\"],\"type\":\"object\"}}},\"description\":\"Device Activation Details.\",\"required\":true},\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"success\":{\"description\":\"Indicates if the RKI activation succeeded.\",\"example\":false,\"type\":\"boolean\"}},\"required\":[\"success\"],\"type\":\"object\"}}},\"description\":\"Device activation result\"},\"401\":{\"content\":{\"application/json\":{\"schema\":{\"description\":\"Error object that is output for unauthoised API calls.\",\"properties\":{\"errorCode\":{\"example\":7401,\"type\":\"integer\"},\"message\":{\"description\":\"Human readable description of the error message.\",\"example\":\"Unauthenticated request.\",\"type\":\"string\"},\"uuid\":{\"example\":\"fe9d