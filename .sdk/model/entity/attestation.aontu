# Entity: attestation

main: kit: entity: attestation: {

  alias: field: {}

  fields: [
    {
      name: "client"
      req: false
      short: "Reference to the associated Client resource."
      type: "`$OBJECT`"
    }
    {
      name: "completeDate"
      req: false
      short: "The date and time that the Attestation took place."
      type: "`$STRING`"
    }
    {
      name: "created"
      req: false
      short: "Creation timestamp in ISO 8601 format."
      type: "`$STRING`"
    }
    {
      name: "device"
      req: false
      short: "Reference to the associated Device resource."
      type: "`$OBJECT`"
    }
    {
      name: "id"
      req: false
      short: "This resource's unique identifier."
      type: "`$STRING`"
    }
    {
      name: "name"
      req: false
      short: "Text describing the attestation."
      type: "`$STRING`"
    }
    {
      name: "notes"
      req: false
      short: "Free form field that allows the Client associate notes with the Attestation."
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "attestation"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/attestations"
          parts: [
            "attestations"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                kind: "query"
                name: "client"
                orig: "client"
                reqd: true
                type: "`$STRING`"
              }
              {
                example: 0
                kind: "query"
                name: "skip"
                orig: "skip"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                example: 10
                kind: "query"
                name: "take"
                orig: "take"
                reqd: false
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/attestations"
          parts: [
            "attestations"
          ]
          select: {
            exist: [
              "client"
              "skip"
              "take"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/attestations/{id}"
          parts: [
            "attestations"
            "{id}"
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
