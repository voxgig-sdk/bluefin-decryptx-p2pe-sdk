# Entity: device_receive_result

main: kit: entity: device_receive_result: {

  alias: field: {}

  fields: {
    serialNumber: {
      h: "Serial Number"
      n: "serialNumber"
      r: true
      sh: "The serial number of the Device that is shipped."
      t: "`$STRING`"
    }
    success: {
      h: "Success"
      n: "success"
      r: true
      sh: "Indicates if the action succeeded."
      t: "`$BOOLEAN`"
    }
    tamperLabel: {
      h: "Tamper Label"
      n: "tamperLabel"
      r: true
      sh: "The code that is printed the tamper label of the Device that is shipped."
      t: "`$STRING`"
    }
  }

  name: "device_receive_result"
  op: {
    create: {
      name: "create"
      points: [
        {
          bf: [
            "serialNumber"
            "tamperLabel"
          ]
          co: {
            id: "POST /devices/receive"
            source: "openapi3"
            version: 2
          }
          m: "POST"
          o: "/devices/receive"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "devices"
            }
            {
              lit: "receive"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
