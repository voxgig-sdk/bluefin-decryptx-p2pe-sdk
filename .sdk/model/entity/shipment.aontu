# Entity: shipment

main: kit: entity: shipment: {

  alias: field: {}

  fields: [
    {
      name: "carrier"
      req: false
      short: "The name of the courier."
      type: "`$STRING`"
    }
    {
      name: "client"
      req: false
      short: "Reference to the associated Client resource."
      type: "`$OBJECT`"
    }
    {
      name: "created"
      req: false
      short: "Creation timestamp in ISO 8601 format."
      type: "`$STRING`"
    }
    {
      name: "dateReceived"
      req: false
      short: "The date and time that a package is recieved."
      type: "`$STRING`"
    }
    {
      name: "dateShipped"
      req: false
      short: "The date and time that a package is shipped."
      type: "`$STRING`"
    }
    {
      name: "dcKif"
      req: false
      short: "Reference to the associated KIF resource."
      type: "`$OBJECT`"
    }
    {
      name: "id"
      req: false
      short: "This resource's unique identifier."
      type: "`$STRING`"
    }
    {
      name: "items"
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "kif"
      req: false
      short: "Reference to the associated KIF resource."
      type: "`$OBJECT`"
    }
    {
      name: "modified"
      req: false
      short: "Last modified timestamp."
      type: "`$STRING`"
    }
    {
      name: "partner"
      req: false
      short: "Reference to the associated Partner."
      type: "`$OBJECT`"
    }
    {
      name: "shipmentType"
      req: false
      short: "The type of shipment."
      type: "`$STRING`"
    }
    {
      name: "tracking"
      req: false
      short: "The courier's tracking number."
      type: "`$STRING`"
    }
    {
      name: "version"
      req: false
      short: "The number of times that this resource has been updated."
      type: "`$INTEGER`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "shipment"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/shipments"
          parts: [
            "shipments"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                kind: "query"
                name: "kif"
                orig: "kif"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "mode"
                orig: "mode"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: 0
                kind: "query"
                name: "skip"
                orig: "skip"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                example: 10
                kind: "query"
                name: "take"
                orig: "take"
                reqd: false
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/shipments"
          parts: [
            "shipments"
          ]
          select: {
            exist: [
              "kif"
              "mode"
              "skip"
              "take"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/shipments/{id}"
          parts: [
            "shipments"
            "{id}"
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
