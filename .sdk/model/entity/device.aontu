# Entity: device

main: kit: entity: device: {

  alias: field: {}

  fields: [
    {
      name: "activatedBy"
      req: true
      type: "`$OBJECT`"
    }
    {
      name: "activationDate"
      req: false
      type: "`$STRING`"
    }
    {
      name: "alternateKey"
      req: false
      type: "`$STRING`"
    }
    {
      name: "auditNextDate"
      req: false
      type: "`$STRING`"
    }
    {
      name: "auditNotificationDate"
      req: false
      type: "`$STRING`"
    }
    {
      name: "client"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "created"
      req: false
      type: "`$STRING`"
    }
    {
      name: "createdBy"
      req: true
      type: "`$OBJECT`"
    }
    {
      name: "deviceBuild"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "deviceState"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "deviceType"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "errorCounter"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "errorLastDate"
      req: false
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
    {
      name: "initializedBy"
      req: true
      type: "`$OBJECT`"
    }
    {
      name: "initializedDate"
      req: false
      type: "`$STRING`"
    }
    {
      name: "injectKey"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "isVirtual"
      req: false
      type: "`$BOOLEAN`"
    }
    {
      name: "kif"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "lastActivityDate"
      req: false
      type: "`$STRING`"
    }
    {
      name: "location"
      req: true
      type: "`$OBJECT`"
    }
    {
      name: "modified"
      req: false
      type: "`$STRING`"
    }
    {
      name: "modifiedBy"
      req: true
      type: "`$OBJECT`"
    }
    {
      name: "name"
      req: false
      type: "`$STRING`"
    }
    {
      name: "notes"
      req: false
      type: "`$STRING`"
    }
    {
      name: "partner"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "serialNumber"
      req: false
      type: "`$STRING`"
    }
    {
      name: "version"
      req: false
      type: "`$INTEGER`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "device"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/devices"
          parts: [
            "devices"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                kind: "query"
                name: "client"
                orig: "client"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "device_state"
                orig: "device_state"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "kif"
                orig: "kif"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "partner"
                orig: "partner"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "serial_number"
                orig: "serial_number"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: 0
                kind: "query"
                name: "skip"
                orig: "skip"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                example: "asc"
                kind: "query"
                name: "sorting_direction"
                orig: "sorting_direction"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: "serialnumber"
                kind: "query"
                name: "sorting_field"
                orig: "sorting_field"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: 10
                kind: "query"
                name: "take"
                orig: "take"
                reqd: false
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/devices"
          parts: [
            "devices"
          ]
          select: {
            exist: [
              "client"
              "device_state"
              "kif"
              "partner"
              "serial_number"
              "skip"
              "sorting_direction"
              "sorting_field"
              "take"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "device_type"
                orig: "device_type"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "serial_number"
                orig: "serial_number"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/devices/{serialNumber}/{deviceType}"
          parts: [
            "devices"
            "{serial_number}"
            "{device_type}"
          ]
          rename: {
            param: {
              deviceType: "device_type"
              serialNumber: "serial_number"
            }
          }
          select: {
            exist: [
              "device_type"
              "serial_number"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/devices/{id}"
          parts: [
            "devices"
            "{id}"
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "device"
      ]
    ]
  }



}
